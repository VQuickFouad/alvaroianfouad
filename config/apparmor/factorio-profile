# ==============================================================================
# Factorio Tech Solutions - Perfil de Seguridad AppArmor
# Ubicación habitual: /etc/apparmor.d/opt.factorio.app.factorio
# Cargar con: sudo apparmor_parser -r /etc/apparmor.d/opt.factorio.app.factorio
# ==============================================================================

#include <tunables/global>

profile factorio-app /opt/factorio/app/.venv/bin/python3 flags=(attach_disconnected) {
    # Inclusión de abstracciones estándar
    #include <abstractions/base>
    #include <abstractions/python>
    #include <abstractions/nameservice>
    #include <abstractions/ssl_certs>

    # Capacidades permitidas (Ninguna capacidad administrativa de root)
    # Capacidad para vincular puertos no privilegiados
    network inet stream,
    network inet6 stream,
    network inet dgram,
    network inet6 dgram,

    # Denegar explícitamente sockets crudos y acceso a administración de red
    deny capability net_admin,
    deny capability net_raw,
    deny capability sys_admin,
    deny capability sys_ptrace,
    deny capability sys_rawio,

    # Acceso al entorno virtual y código de la aplicación
    /opt/factorio/ r,
    /opt/factorio/app/ r,
    /opt/factorio/app/** r,
    /opt/factorio/app/.venv/** rix,
    /usr/bin/python3* ix,

    # Permisos de lectura/escritura en directorios de datos y logs
    /opt/factorio/app/data/ rw,
    /opt/factorio/app/data/** rwk,
    /opt/factorio/app/logs/ rw,
    /opt/factorio/app/logs/** rwk,

    # Lectura del archivo de variables de entorno (solo lectura)
    /opt/factorio/app/.env r,

    # Acceso de solo lectura al sistema de auditoría (/proc y /sys limitados)
    /proc/sys/net/** r,
    /proc/loadavg r,
    /proc/meminfo r,
    /proc/stat r,
    /proc/uptime r,
    /proc/version r,
    /proc/net/dev r,
    /sys/devices/system/cpu/** r,

    # Lectura de configuraciones del sistema para la auditoría de seguridad
    /etc/ssh/sshd_config r,
    /etc/ssh/sshd_config.d/ r,
    /etc/ssh/sshd_config.d/* r,
    /etc/ufw/ r,
    /etc/ufw/** r,

    # Binarios auxiliares permitidos para recolección de diagnósticos
    /usr/bin/restic rix,
    /usr/bin/sqlite3 rix,
    /usr/bin/ss rix,
    /usr/bin/uptime rix,

    # Directorio temporal para operaciones atómicas
    /tmp/ rw,
    /tmp/** rwk,

    # Denegación explícita de lectura en ubicaciones sensibles del sistema
    deny /etc/shadow* rwklx,
    deny /etc/gshadow* rwklx,
    deny /root/** rwklx,
    deny /home/*/.ssh/** rwklx,
}
