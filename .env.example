# ==============================================================================
# Factorio Tech Solutions - Plantilla de Variables de Entorno (.env.example)
# ==============================================================================
# Copie este archivo como .env y ajuste los valores según su entorno.
# NUNCA guarde contraseñas reales ni claves de producción en control de versiones.

# --- Configuración General de la Aplicación ---
APP_NAME=Factorio Tech Solutions
DEBUG=false
DEMO_MODE=true
# Generar una clave segura en producción (ejemplo: openssl rand -hex 32)
SECRET_KEY=cambiar-esta-clave-en-produccion
AUTH_SETUP_TOKEN=
SESSION_COOKIE_SECURE=true
DATABASE_URL=sqlite:///./data/factorio.db
LOG_LEVEL=INFO

# --- Monitorización y Métricas (Netdata) ---
# En modo demo o lab Docker: http://localhost:19999 o http://netdata:19999
NETDATA_URL=http://localhost:19999
METRICS_INTERVAL=30

# --- Agregación de Registros (Grafana Loki) ---
# En modo demo o lab Docker: http://localhost:3100 o http://loki:3100
LOKI_URL=http://localhost:3100
LOG_RETENTION_DAYS=30

# --- Inteligencia Artificial y Chatbot ---
# Proveedores soportados: 'none' (deshabilitado/simulado), 'openai', 'ollama'
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=gpt-4
AI_BASE_URL=https://api.openai.com/v1

# --- Bot de Notificaciones Telegram ---
# Obtener Token con @BotFather en Telegram
TELEGRAM_BOT_TOKEN=
# IDs numéricos de Telegram separados por coma (ejemplo: 123456789,987654321)
TELEGRAM_ALLOWED_USERS=

# --- Copias de Seguridad (Restic) ---
# Ruta local (/var/backups/factorio) o repositorio remoto sftp/s3
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
RESTIC_BACKUP_PATHS=
RESTIC_TIMEOUT_SECONDS=300

# --- Configuración de Red del Servidor ---
HOST=0.0.0.0
PORT=8000
