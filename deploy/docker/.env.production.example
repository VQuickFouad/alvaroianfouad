APP_NAME=Factorio Tech Solutions
DEBUG=false
DEMO_MODE=false
SECRET_KEY_FILE=/run/secrets/app_secret_key
AUTH_SETUP_TOKEN_FILE=/run/secrets/auth_setup_token
SESSION_COOKIE_SECURE=true
SESSION_TTL_HOURS=8
DATABASE_URL=sqlite:////opt/factorio/app/data/factorio.db
LOG_LEVEL=INFO

# Set these to endpoints reachable from the production container, or leave blank.
NETDATA_URL=
LOKI_URL=

AI_PROVIDER=none
AI_API_KEY=
AI_API_KEY_FILE=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_TOKEN_FILE=
TELEGRAM_ALLOWED_USERS=

# Use a remote repository or a separately managed storage volume.
RESTIC_REPOSITORY=
RESTIC_PASSWORD_FILE=/run/secrets/restic_password
RESTIC_BACKUP_PATHS=["/opt/factorio/app/data","/opt/factorio/app/config"]
RESTIC_TIMEOUT_SECONDS=300

HOST=0.0.0.0
PORT=8000
