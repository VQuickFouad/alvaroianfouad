# ==============================================================================
# Factorio Tech Solutions - Variables de Entorno para Docker Compose (.env.docker)
# Ubicación: deploy/docker/.env.docker
# ==============================================================================

APP_NAME=Factorio Tech Solutions (Docker Lab)
DEBUG=false
DEMO_MODE=true
SECRET_KEY=replace-with-a-random-secret-for-local-use-only
AUTH_SETUP_TOKEN=
SESSION_COOKIE_SECURE=false
DATABASE_URL=sqlite:////opt/factorio/app/data/factorio.db
LOG_LEVEL=INFO

# Red interna de Docker hacia Netdata y Loki
NETDATA_URL=http://netdata:19999
METRICS_INTERVAL=15
LOKI_URL=http://loki:3100
LOG_RETENTION_DAYS=7

# Proveedor de IA (none para laboratorio sin claves)
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=gpt-4
AI_BASE_URL=https://api.openai.com/v1

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=

# Respaldo
RESTIC_REPOSITORY=/opt/factorio/app/data/restic-repo
RESTIC_PASSWORD=
RESTIC_BACKUP_PATHS=[]

# Red interna
HOST=0.0.0.0
PORT=8000
